/// One row per coupon redemption (2,318).
table 'Coupon Redemption'

	/// Number of coupon redemptions.
	measure Redemptions = COUNTROWS('Coupon Redemption')
		formatString: #,##0
		displayFolder: Campaigns

	/// Coupon discount on same-day purchases of the coupon's eligible products.
	measure 'Redeemed Coupon Value' = SUM('Coupon Redemption'[Redeemed Discount Value])
		formatString: $#,##0
		displayFolder: Campaigns

	column 'Household Key'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: household_sk

	column 'Campaign Key'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: campaign_sk

	column 'Date Key'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: date_key

	column 'Redeemed Discount Value'
		dataType: decimal
		isHidden
		formatString: #,##0.00
		sourceColumn: coupon_discount_value

	partition 'Coupon Redemption' = entity
		mode: directLake
		source
			entityName: fct_coupon_redemption
			schemaName: marts
			expressionSource: 'DirectLake - Retail Promotions'

