	toColumn: Household.'Household Key'

relationship 'Basket to Store Store Key'
	fromColumn: Basket.'Store Key'
	toColumn: Store.'Store Key'

relationship 'Promotion Week to Product Product Key'
	fromColumn: 'Promotion Week'.'Product Key'
	toColumn: Product.'Product Key'

relationship 'Promotion Week to Store Store Key'
