/// One row per shopping trip (276k baskets).
table Basket
	lineageTag: 6739ed85-1d7a-404e-bcdc-cb777d68e5dd

	/// Number of shopping trips.
	measure Baskets = COUNTROWS(Basket)
		formatString: #,##0
		displayFolder: Baskets
		lineageTag: e797f506-3236-4268-82c2-ed128578eb9f

	/// Average sales value per shopping trip.
	measure 'Average Basket Value' = DIVIDE(SUM(Basket[Basket Sales Value]), [Baskets])
		formatString: £#,##0.00
		displayFolder: Baskets
		lineageTag: af6fae3f-ee9f-4b1f-9d72-a74959062a0a

	/// Average units per shopping trip.
	measure 'Items per Basket' = DIVIDE(SUM(Basket[Item Quantity]), [Baskets])
		formatString: #,##0.0
		displayFolder: Baskets
		lineageTag: 5459d480-7b44-4237-9f6a-9add9715424d

	/// Share of shopping trips using at least one manufacturer coupon.
	measure 'Coupon Basket %' = DIVIDE(CALCULATE([Baskets], Basket[Has Coupon] = 1), [Baskets])
		formatString: 0.0%
		displayFolder: Baskets
		lineageTag: 0facc718-feeb-44ea-ada9-f406261e427d

	column 'Household Key'
		dataType: string
		isHidden
		lineageTag: c4863a5f-fbb1-4863-a4e9-cab1880d735b
		summarizeBy: none
		sourceColumn: household_sk

	column 'Store Key'
		dataType: string
		isHidden
		lineageTag: 871f41f6-6769-4e70-826d-33523da47943
		summarizeBy: none
		sourceColumn: store_sk

	column 'Date Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 790badf3-4b42-46ff-b8d2-0d66af51d00d
		summarizeBy: none
		sourceColumn: date_key

	column 'Item Quantity'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 509a99ed-420a-4233-9138-4b6fe8bcbf7c
		summarizeBy: sum
		sourceColumn: item_quantity

		annotation SummarizationSetBy = Automatic

	column 'Distinct Products'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 9a835e29-91e7-4914-af1a-e2bfaa0f6732
		summarizeBy: sum
		sourceColumn: distinct_products

		annotation SummarizationSetBy = Automatic

	column 'Basket Sales Value'
		dataType: double
		isHidden
		formatString: #,##0.00
		lineageTag: 82c922af-26a1-4cb7-aa48-07cf11362cc6
		summarizeBy: sum
		sourceColumn: sales_value

		annotation SummarizationSetBy = Automatic

	/// 1 when any line in the basket used a manufacturer coupon.
	column 'Has Coupon'
		dataType: int64
		formatString: 0
		lineageTag: cfd03cc9-2cd4-46c1-9d35-2764acae83f7
		summarizeBy: sum
		sourceColumn: has_coupon

		annotation SummarizationSetBy = Automatic

	column basket_id
