		formatString: #,##0.00
		lineageTag: 311b4967-6fcd-47e2-ad69-abb289ac08cc
		summarizeBy: sum
		sourceColumn: avg_sales_before_targeted

		annotation SummarizationSetBy = Automatic

	column 'Lift per Household Value'
