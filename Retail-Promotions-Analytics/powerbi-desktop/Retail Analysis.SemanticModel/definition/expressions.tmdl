/// wh_gold through the OneLake catalog (Fabric Warehouse connector); every table reads from here
expression wh_gold =
		let
			Source = Fabric.Warehouse([]),
			Workspace = Source{[workspaceId = WorkspaceId]}[Data],
			Warehouse = Workspace{[warehouseId = WarehouseId]}[Data]
		in
			Warehouse
